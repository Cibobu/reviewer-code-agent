# --- LLM (OpenAI-compatible) -------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- GitHub (optional — private repos or higher rate limits) -----------------
GITHUB_TOKEN=

# --- Agent B: Telegram review bot --------------------------------------------
TELEGRAM_BOT_TOKEN=
# HTTPS public URL where this server is reachable (no trailing slash)
PUBLIC_BASE_URL=https://your-bot.example.com

# Optional: fallback chat for npm run calibrate:b (normally set per-user via bot)
TELEGRAM_CHAT_ID=

# Data dir for per-chat configs (default: ./data/agent-b)
# AGENT_B_DATA_DIR=/var/lib/agent-b

# --- HTTP server -------------------------------------------------------------
# Agent A default: 9004 · Agent B default: 9005
PORT=9004

# --- Agent C: GitGuardian AI SaaS --------------------------------------------
# Docker defaults (npm run infra:c): PG on 5433, Redis on 6380 — avoids local conflicts
# DATABASE_URL=postgresql://gitguardian:gitguardian@localhost:5433/gitguardian
# REDIS_URL=redis://localhost:6380
# Or use existing local PostgreSQL on 5432 (create DB + user first):
# DATABASE_URL=postgresql://YOUR_USER:YOUR_PASS@localhost:5432/gitguardian
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
# JWT_SECRET=change-me-in-production
# JWT_REFRESH_SECRET=change-me-refresh-in-production
# ENCRYPTION_KEY=32-byte-hex-or-passphrase-for-aes-256
# API_PORT=4000
# WEB_URL=http://localhost:3000
# PUBLIC_API_URL=https://xxxx.ngrok-free.app
# No trailing slash. Use https for ngrok (not http).
# ngrok: tunnel the API — `ngrok http 4000` (recommended).
# If you tunnel the web app (`ngrok http 3000`), Next.js proxies /api/* to port 4000.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
