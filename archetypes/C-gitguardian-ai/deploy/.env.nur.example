# nur@34.101.221.255 — tanpa sudo / tanpa Docker
# Copy: cp archetypes/C-gitguardian-ai/deploy/.env.nur.example .env
# Domain: https://nur.foruai.io

# Neon pooler URL — WAJIB tambah pgbouncer=true, JANGAN pakai channel_binding=require
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Alternatif: direct URL (tanpa -pooler) — lebih stabil untuk PM2/worker
# DATABASE_URL=postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Redis gratis: https://upstash.com (pakai URL TLS rediss://)
REDIS_URL=rediss://default:PASS@xxx.upstash.io:6379

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://nur.foruai.io/api/auth/github/callback

GITHUB_TOKEN=

# Generate: openssl rand -hex 32 (JWT) / openssl rand -hex 16 (ENCRYPTION)
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

WEB_URL=https://nur.foruai.io
PUBLIC_API_URL=https://nur.foruai.io
NEXT_PUBLIC_API_URL=https://nur.foruai.io/api

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

API_PORT=4000
